# Copia este archivo a .env (no subas .env a Git).

# ── Base de datos (Supabase pooler recomendado en Railway) ──
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase Auth (cuentas de usuario + piloto abierto) ──
# Dashboard → Project Settings → API
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
# JWT Secret (mismo panel API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=tu-jwt-secret

# Tu UUID de usuario (Authentication → Users → copiar UID) para ver Promoselect y marcas legacy:
# ADMIN_USER_IDS=uuid-de-jeronimo

# ── IA y Quick Start (piloto) ──
DEMO_MODE=true
OPENAI_API_KEY=sk-...

# ── Modo legacy (solo si NO usas Supabase Auth) ──
# DASHBOARD_PASSWORD=contraseña-compartida

# Migración local:
#   python3 migrate_comercial_v21.py --sqlite
# Migración Supabase:
#   python3 migrate_comercial_v21.py
